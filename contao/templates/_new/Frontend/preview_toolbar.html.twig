    float: right;
    padding: 0;
    cursor: pointer;
    position: absolute;
    top: 10px;
    right: 10px;
  }

  #slide-out .title {
    font-size: 16px;
    font-weight: 700;
    margin-bottom: 2px;
  }

  #slide-out .title span {
    font-weight: 400;
  }

  #slide-out .subheader {
    font-size: 18px;
    padding: 0;
    margin: 20px 32px 15px;
    border-bottom: 1px solid #565656;
    color: #fff;
  }

  span.colors {
    display: flex;
    height: 5px;
    width: 100%;
  }

  span.colors span {
    width: 100%;
    height: 100%;
  }

  @media (max-width: 992px) {
    #slide-out.sidenav {
      padding: 0 0 100px
    }
  }

  @media (max-width: 600px) {
    #slide-out {
      width: 100%
    }
  }
</style>
